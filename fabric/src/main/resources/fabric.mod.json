{
  "schemaVersion": 1,
  "id": "ticksight",
  "version": "${version}",
  "name": "TickSight",
  "icon": "assets/ticksight/icon.png",
  "description": "See what's lagging your world.",
  "authors": ["Anixty", "tasgon (Observable)"],
  "contact": {
    "homepage": "https://ticksight.anixty.net/",
    "sources": "https://github.com/Anixty/TickSight",
    "issues": "https://github.com/Anixty/TickSight/issues"
  },
  "license": "MPL-2.0",
  "environment": "*",
  "entrypoints": {
    "main": ["net.anixty.ticksight.fabric.TickSightFabric"],
    "client": ["net.anixty.ticksight.fabric.Client"]
  },
  "mixins": ["ticksight.mixins.json"],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*",
    "fabric-language-kotlin": ">=${fabric_language_kotlin_version}",
    "java": ">=${java_version}",
    "minecraft": "${minecraft_version}",
    "architectury": ">=${architectury_version}"
  },
  "breaks": {
    "observable": "*"
  }
}
